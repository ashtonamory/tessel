[
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Summary of the open document: revision, title, path, dirty, pages with their layer trees (summarised below `depth`), tokens, styles and components.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "depth": {
          "default": 1,
          "description": "Levels of children listed under each page; deeper levels are\nsummarised as `\"children\": <count>`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "page_id": {
          "default": null,
          "description": "Only this page. Without it, every page.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "GetDocumentArgs",
      "type": "object"
    },
    "name": "get_document"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "One node in file-format JSON (what you can write back with update_node), its absolute page-space geometry, parent, index and name path.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "depth": {
          "default": 1,
          "description": "Levels of children included in full; deeper levels are summarised as\n`\"children\": <count>`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "include_geometry": {
          "default": true,
          "description": "Include the absolute page-space box `{ x, y, width, height, rotation }`.",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "GetNodeArgs",
      "type": "object"
    },
    "name": "get_node"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Find nodes by name substring, kind, text content and/or ancestor.",
    "inputSchema": {
      "$defs": {
        "Kind": {
          "enum": [
            "frame",
            "group",
            "rect",
            "ellipse",
            "text",
            "image",
            "vector",
            "instance"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "default": 50,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "default": null,
          "description": "Case-insensitive substring of the layer name.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "default": null,
          "description": "Case-insensitive substring of a text node's content.",
          "type": [
            "string",
            "null"
          ]
        },
        "within": {
          "default": null,
          "description": "Only search inside this node or page.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "FindNodesArgs",
      "type": "object"
    },
    "name": "find_nodes"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "What the user has selected right now and the top-level frame it is in. Call this when the user says \"this\" or \"the selected …\".",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "EmptyArgs",
      "type": "object"
    },
    "name": "get_selection"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "All design tokens and styles in file-format JSON.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "EmptyArgs",
      "type": "object"
    },
    "name": "get_tokens"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Create a node, or a whole subtree via nested `children`, in one undo step. Returns the root `id` and `ids`, mapping each created node's name path (\"Card/Title\") to its ID.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index": {
          "default": null,
          "description": "Position among the parent's children (back to front); default last.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "node": {
          "additionalProperties": true,
          "description": "Node JSON as in the file format, without `id` (IDs are assigned). A\nnested `children` array creates the whole subtree. Requires `kind`.",
          "type": "object"
        },
        "parent_id": {
          "description": "A node ID (a frame or group) or a page ID.",
          "type": "string"
        },
        "select": {
          "default": false,
          "description": "Select the new node.",
          "type": "boolean"
        }
      },
      "required": [
        "parent_id",
        "node"
      ],
      "title": "CreateNodeArgs",
      "type": "object"
    },
    "name": "create_node"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Change any props of one node with a partial file-format JSON patch.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "patch": {
          "additionalProperties": true,
          "description": "Any subset of the node's props in file-format JSON. Unknown keys and\nkeys that do not apply to the node's kind are errors; `null` clears an\noptional prop.",
          "type": "object"
        }
      },
      "required": [
        "id",
        "patch"
      ],
      "title": "UpdateNodeArgs",
      "type": "object"
    },
    "name": "update_node"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Patch several nodes in one undo step.",
    "inputSchema": {
      "$defs": {
        "NodeUpdate": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "patch": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "required": [
            "id",
            "patch"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "updates": {
          "items": {
            "$ref": "#/$defs/NodeUpdate"
          },
          "type": "array"
        }
      },
      "required": [
        "updates"
      ],
      "title": "UpdateNodesArgs",
      "type": "object"
    },
    "name": "update_nodes"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Delete nodes and their subtrees.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "ids"
      ],
      "title": "DeleteNodesArgs",
      "type": "object"
    },
    "name": "delete_nodes"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Reparent and/or reorder and/or reposition a node.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index": {
          "default": null,
          "description": "Position in the parent's children after the node is taken out;\ndefault last when reparenting, unchanged otherwise.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parent_id": {
          "default": null,
          "description": "New parent (node or page); default the current one.",
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "default": null,
          "description": "New position relative to the parent.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "default": null,
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "title": "MoveNodeArgs",
      "type": "object"
    },
    "name": "move_node"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Copy a node and its subtree with new IDs.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index": {
          "default": null,
          "description": "Default: just above the original, or last in another parent.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": null,
          "description": "Added to the copy's `x`, `y`; default `[0, 0]`.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "parent_id": {
          "default": null,
          "description": "Default: the original's parent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "title": "DuplicateNodeArgs",
      "type": "object"
    },
    "name": "duplicate_node"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Add, change or remove (`null`) color, spacing, radius and font tokens. Reference them in props as \"{color.primary}\".",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": {},
          "description": "`\"color.primary\": \"#2563eb\"`; `null` removes the token.",
          "type": "object"
        },
        "fonts": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": {},
          "type": "object"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "radii": {
          "additionalProperties": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "default": {},
          "type": "object"
        },
        "spacing": {
          "additionalProperties": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "default": {},
          "type": "object"
        }
      },
      "title": "SetTokensArgs",
      "type": "object"
    },
    "name": "set_tokens"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Create a named fill, stroke, text or effect style, or update one by `id`.",
    "inputSchema": {
      "$defs": {
        "StyleKindArg": {
          "enum": [
            "fill",
            "stroke",
            "text",
            "effect"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": null,
          "description": "Update this style; without it a new style is created.",
          "type": [
            "string",
            "null"
          ]
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/StyleKindArg"
        },
        "name": {
          "description": "\"Heading/H1\"; '/' groups styles in the UI.",
          "type": "string"
        },
        "value": {
          "additionalProperties": true,
          "description": "The kind's fields in file-format JSON: fill `{ fills }`, stroke\n`{ strokes, width }`, text `{ style }`, effect `{ shadows }`.",
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind",
        "value"
      ],
      "title": "UpsertStyleArgs",
      "type": "object"
    },
    "name": "upsert_style"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Apply a style to nodes, or detach it (`style_id: null`).",
    "inputSchema": {
      "$defs": {
        "StyleKindArg": {
          "enum": [
            "fill",
            "stroke",
            "text",
            "effect"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/StyleKindArg"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which reference to set; default from the style's kind. With\n`style_id: null` and no slot, every style is detached."
        },
        "style_id": {
          "description": "The style to apply, or `null` to detach (copy the style's values onto\nthe nodes and clear the reference).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "node_ids"
      ],
      "title": "ApplyStyleArgs",
      "type": "object"
    },
    "name": "apply_style"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Turn a frame into a component. The frame stays in place as an instance with the same ID (`instance_id`); the master is the new component.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "from_id": {
          "description": "The frame to turn into a component. It stays where it is, as an\ninstance with the same ID.",
          "type": "string"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "The component's name, e.g. \"Button/Primary\"; default the frame's name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from_id"
      ],
      "title": "CreateComponentArgs",
      "type": "object"
    },
    "name": "create_component"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Place an instance of a component, optionally with overrides keyed by component node ID.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "type": "string"
        },
        "if_revision": {
          "default": null,
          "description": "Fail with `stale_revision` unless the document is at this revision\n(from an earlier result or `get_document`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index": {
          "default": null,
          "description": "Position among the parent's children (back to front); default last.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "overrides": {
          "additionalProperties": true,
          "default": null,
          "description": "Overrides by the component node they apply to, as in the file format:\n`{ \"<componentNodeId>\": { \"type\": \"text\", \"content\": \"Pay\" } }`. Types:\n`text` (`content`), `fills` (`fills`), `visible` (`visible`) and\n`swap` (`component`).",
          "type": [
            "object",
            "null"
          ]
        },
        "parent_id": {
          "description": "A node ID (a frame or group) or a page ID.",
          "type": "string"
        },
        "select": {
          "default": false,
          "description": "Select the new instance.",
          "type": "boolean"
        },
        "x": {
          "default": null,
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "default": null,
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "component_id",
        "parent_id"
      ],
      "title": "CreateInstanceArgs",
      "type": "object"
    },
    "name": "create_instance"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Select nodes in the app to point the user at them. Not an edit; not in history.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "zoom_to": {
          "default": false,
          "description": "Also scroll and zoom the canvas to the nodes.",
          "type": "boolean"
        }
      },
      "required": [
        "ids"
      ],
      "title": "SetSelectionArgs",
      "type": "object"
    },
    "name": "set_selection"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Render a node exactly as the canvas shows it, as a PNG. Use it after edits to check your work.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "background": {
          "default": null,
          "description": "`#rrggbb[aa]` painted behind the node; default transparent.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "max_size": {
          "default": 1600,
          "description": "Longest side in pixels; the scale is reduced to fit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scale": {
          "default": 1.0,
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "ScreenshotArgs",
      "type": "object"
    },
    "name": "screenshot"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Export a node as HTML + CSS, Tailwind or React code. Returns the files (`path`, `language`, `content`; image files are base64 with `encoding: \"base64\"`). Nothing is written to disk.",
    "inputSchema": {
      "$defs": {
        "CodeFormatArg": {
          "enum": [
            "html",
            "tailwind",
            "react"
          ],
          "type": "string"
        },
        "ExportCodeOptions": {
          "additionalProperties": false,
          "properties": {
            "include_components": {
              "default": null,
              "description": "React: one file per component, instances call it. Default true.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "responsive": {
              "default": null,
              "description": "The root takes the full width up to its design width. Default false.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "tailwind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TailwindArg"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tailwind version for `tailwind` and `react`; default `v4`."
            },
            "tokens": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TokenModeArg"
                },
                {
                  "type": "null"
                }
              ],
              "description": "How token references are written; default `css_vars`."
            }
          },
          "type": "object"
        },
        "TailwindArg": {
          "enum": [
            "v4",
            "v3"
          ],
          "type": "string"
        },
        "TokenModeArg": {
          "enum": [
            "css_vars",
            "inline"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/CodeFormatArg"
        },
        "id": {
          "type": "string"
